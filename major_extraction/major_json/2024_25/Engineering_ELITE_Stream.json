  "notes": [
    {
      "marker": "[a]",
      "text": "Students can use up to 9 units of courses which have been taken to fulfill the requirements of the ELITE Stream requirements to fulfill the elective requirements of the ELITE Stream. Item 3(b) Research Component Courses will not be included in these 9 units. A full list of ESTR courses is available at the ELITE website."
    },
    {
      "marker": "[b]",
      "text": "Students may count up to 9 units completed for their underlying Major Programme toward the ELITE Stream elective requirements. Research Component Courses in section 3 are excluded from this 9-unit overlap. A full list of ESTR courses is available at the ELITE website."
    },
    {
      "marker": "[c]",
      "text": "The requirement of at least 3 units of Engineering courses at 5000 level is a requirement for the ELITE Stream only. It should not be interpreted as a requirement of the Major Programme."
    }
  ],

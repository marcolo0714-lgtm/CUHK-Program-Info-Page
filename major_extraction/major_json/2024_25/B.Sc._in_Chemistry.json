    },
    {
      "marker": "2.",
      "text": "Potential students majoring in Chemistry are strongly recommended to take CHEM1870 as basic training to prepare for laboratory classes in upper years.",
      "subsections": [],
      "rows": []
    },
    {
      "marker": "3.",
      "text": "A student in the final year of attendance may, under special circumstances and with written approval from the Department, select CHEM4480 and/or 4490 to substitute up to 4 units of any courses in the Chemistry Programme.",
      "subsections": [],
      "rows": []
    },
    {
      "marker": "4.",
      "text": "Students in their final year of attendance may, subject to approval by the Department, select CHEM4980/4990 and submit an undergraduate thesis in place of CHEM4030/4040.",
      "subsections": [],
      "rows": []
    },
    {
      "marker": "[a]",
      "text": "Students may select research-oriented course(s), as approved by the Major Programme, to substitute up to 4 units for fulfillment of Research Courses requirement.",
      "subsections": [],
      "rows": []
    },
    {
      "marker": "[b]",
      "text": "Students must complete any exchange/research/internship programme(s) offered by the University, Colleges, the Faculty of Science or Major Programme, as approved by the Major Programme, to fulfill the Experiential Learning requirement. Students are responsible for the extra costs incurred in the exchange/research/internship programme(s).",
      "subsections": [],
      "rows": []
    }

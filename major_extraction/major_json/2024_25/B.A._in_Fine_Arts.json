  "notes": [
    {
      "marker": "1.",
      "text": "Students may select up to four courses (12 units) out of CURE2031, 2037, 3017#, 3020# offered by the Department of Cultural and Religious Studies as Art History elective courses. Students taking the above CURE courses in fulfilling the Fine Arts Major requirement should indicate which course(s) is/are to be counted at their final term of attendance.",
      "subsections": [],
      "rows": []
    },
    {
      "marker": "2.",
      "text": "FAAS courses at 3000 and above level as well as those labeled as # will be included in the calculation of Major GPA for honours classification.",
      "subsections": [],
      "rows": []
    },
    {
      "marker": "3.",
      "text": "A Fine Arts Major student who pursues a second Major in Chinese Language and Literature can be exempted from taking CHLL4403, 4332, 4121, 4401 and 4402 by taking FAAS2117, 3105, 3223, 4106 and 4109 respectively. Units earned can be counted towards both Major Programmes.",
      "subsections": [],
      "rows": []
    },
    {
      "marker": "[a]",
      "text": "A student in Art History stream is required to submit a thesis, pass an oral examination on his/her thesis, and participate in the Graduation Exhibition in the final year of attendance.",
      "subsections": [],
      "rows": []
    },
    {
      "marker": "[b]",
      "text": "A student in Studio Art stream is required to submit studio works for the Graduation Exhibition and pass an oral examination in the final year of attendance.",
      "subsections": [],
      "rows": []
    },
    {
      "marker": "[c]",
      "text": "A student in the Art History and Studio Art stream is required to submit either a thesis OR studio works, pass an oral examination, and participate in the Graduation Exhibition in the final year of attendance.",
      "subsections": [],
      "rows": []
    }
  ],

          "notes": [
            {
              "marker": "1.",
              "text": "GLSD courses at 2000 and above level as well as those labeled as # will be included in the calculation of Major GPA for honours classification.",
              "subsections": [],
              "rows": []
            },
            {
              "marker": "2.",
              "text": "Students may be required to participate in activities such as field trips and study tours that foster their learning of global studies.",
              "subsections": [],
              "rows": []
            },
            {
              "marker": "3.",
              "text": "Students who participate in the Dual Undergraduate Degree Programme (DDP) must first complete at least 42 units of courses of Major requirements at CUHK. Upon completion of their studies at Waseda, students may apply to transfer up to 18 units of courses to fulfill the Major requirements at CUHK, including the 9-unit requirement of Resident Study Overseas and up to 9 units of the remaining Major requirements.",
              "subsections": [],
              "rows": []
            },
            {
              "marker": "4.",
              "text": "Students are responsible for the extra costs incurred in relation to the overseas resident study and the participation of the DDP.",
              "subsections": [],
              "rows": []
            },
            {
              "marker": "[a]",
              "text": "Among the non-GLSD courses, students can only choose up to three courses under the same subject area.",
              "subsections": [],
              "rows": []
            }
          ],

  "notes": [
    {
      "marker": "1.",
      "text": "LING courses at 2000 and above level as well as those labeled as # will be included in the calculation of Major GPA for honours classification.",
      "subsections": [],
      "rows": []
    },
    {
      "marker": "2.",
      "text": "Students may be required to participate in activities such as field trips and study tours that foster their learning of linguistics. Students are responsible for part of or all costs incurred in relation to these activities.",
      "subsections": [],
      "rows": []
    },
    {
      "marker": "3.",
      "text": "Students whose first language is not Chinese may take Cantonese and Putonghua as language courses for 3(b).",
      "subsections": [],
      "rows": []
    },
    {
      "marker": "4.",
      "text": "A Linguistics Major student who pursues a second Major in Chinese Language and Literature can be exempted from taking CHLL3162, 4161 and 4110 by taking LING1002, 3108 and 4401 respectively. Units earned can be counted towards both Major Programmes.",
      "subsections": [],
      "rows": []
    },
    {
      "marker": "5.",
      "text": "A Linguistics Major student who pursues a second Major in Psychology can be exempted from taking PSYC3430 by taking LING3202. Units earned can be counted towards both Major Programmes.",
      "subsections": [],
      "rows": []
    },
    {
      "marker": "6.",
      "text": "A Linguistics Major student who pursues a second Major in Translation can be exempted from taking TRAN2610 by taking LING3401. Units earned can be counted towards both Major Programmes.",
      "subsections": [],
      "rows": []
    },
    {
      "marker": "[a]",
      "text": "The course not taken to fulfill requirement 2(a) may be taken as a free elective course.",
      "subsections": [],
      "rows": []
    }

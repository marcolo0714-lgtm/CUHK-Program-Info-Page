{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/2026_27/",
      "permanent": true
    },
    {
      "source": "/major",
      "destination": "/major/2026_27/",
      "permanent": true
    },
    {
      "source": "/major/",
      "destination": "/major/2026_27/",
      "permanent": true
    },
    {
      "source": "/2025_26/minors/HB_Minor_Programme_in_Hong_Kong_Sign_Language",
      "destination": "/2025_26/minors/Hong_Kong_Sign_Language",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400"
        },
        {
          "key": "Content-Security-Policy",
          "value": "prefetch-src 'none'"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}

  "explanatory_notes": "<table><tr>\n<td colspan=\"3\" style=\"width:437.1pt;padding:0cm 5.4pt 0cm 5.4pt\" valign=\"top\" width=\"583\">\n<p class=\"MsoNormal\" style=\"margin-right:.1pt;text-align:justify;\n\n      text-justify:inter-ideograph;line-height:14.0pt\"><span lang=\"EN-US\"> </span></p>\n<p class=\"MsoNormal\" style=\"margin-right:.1pt;text-align:justify;\n\n      text-justify:inter-ideograph;line-height:14.0pt\"><span lang=\"EN-US\">Explanatory\n\n      Notes:</span></p>\n</td>\n</tr>\n<tr>\n<td style=\"width:35.1pt;padding:0cm 5.4pt 0cm 5.4pt\" valign=\"top\" width=\"47\">\n<p class=\"MsoNormal\" style=\"margin-right:.1pt;text-align:justify;\n\n      text-justify:inter-ideograph;line-height:14.0pt\"><span lang=\"EN-US\">1.</span></p>\n</td>\n<td colspan=\"2\" style=\"width:402.0pt;padding:0cm 5.4pt 0cm 5.4pt\" valign=\"top\" width=\"536\">\n<p class=\"MsoNormal\" style=\"margin-right:.1pt;text-align:justify;\n\n      text-justify:inter-ideograph;line-height:14.0pt\"><span lang=\"EN-US\">This\n\n      Minor Programme is not</span> for students whose native language is\n\n      Cantonese/Putonghua<span lang=\"EN-US\">. Students planning to minor in this\n\n      Programme should take the Putonghua placement tests offered by the\n\n      Yale-China Chinese Language </span>Academy<span lang=\"EN-US\">.  Declaration\n\n      of this Minor Programme is subject to approval of the Department.</span></p>\n</td>\n</tr>\n<tr>\n<td style=\"width:35.1pt;padding:0cm 5.4pt 0cm 5.4pt\" valign=\"top\" width=\"47\">\n<p class=\"MsoNormal\" style=\"margin-right:.1pt;text-align:justify;\n\n      text-justify:inter-ideograph;line-height:14.0pt\"><span lang=\"EN-US\">2.</span></p>\n</td>\n<td colspan=\"2\" style=\"width:402.0pt;padding:0cm 5.4pt 0cm 5.4pt\" valign=\"top\" width=\"536\">\n<p class=\"MsoNormal\" style=\"margin-right:.1pt;text-align:justify;\n\n      text-justify:inter-ideograph;line-height:14.0pt\"><span lang=\"EN-US\">Depending\n\n      on their proficiency in Putonghua, students may be asked to take advanced\n\n      level courses to substitute for the courses at the 2000 level to fulfill\n\n      the Minor Programme requirement.  They should seek advice from the\n\n      Yale-China Chinese Language </span>Academy<span lang=\"EN-US\">for the\n\n      substitute courses for them to take. </span></p>\n</td>\n</tr>\n<tr style=\"height:9.9pt\">\n<td style=\"width:35.1pt;padding:0cm 5.4pt 0cm 5.4pt;\n\n      height:9.9pt\" valign=\"top\" width=\"47\">\n<p class=\"MsoNormal\" style=\"margin-right:.1pt;text-align:justify;\n\n      text-justify:inter-ideograph;line-height:14.0pt\"><span lang=\"EN-US\">3.</span></p>\n</td>\n<td colspan=\"2\" style=\"width:402.0pt;padding:0cm 5.4pt 0cm 5.4pt;\n\n      height:9.9pt\" valign=\"top\" width=\"536\">\n<p class=\"MsoNormal\" style=\"margin-right:.1pt;text-align:justify;\n\n      text-justify:inter-ideograph;line-height:14.0pt\"><span lang=\"EN-US\">All\n\n      CLCP courses taken to fulfill this Minor programme requirement cannot be\n\n      counted towards the fulfillment of the University Core Requirements.</span></p>\n</td>\n</tr>\n<tr style=\"height:9.9pt\">\n<td style=\"width:35.1pt;padding:0cm 5.4pt 0cm 5.4pt;\n\n      height:9.9pt\" valign=\"top\" width=\"47\">\n<p class=\"MsoNormal\" style=\"margin-right:.1pt;text-align:justify;\n\n      text-justify:inter-ideograph;line-height:14.0pt\"><span lang=\"EN-US\">4.</span></p>\n</td>\n<td colspan=\"2\" style=\"width:402.0pt;padding:0cm 5.4pt 0cm 5.4pt;\n\n      height:9.9pt\" valign=\"top\" width=\"536\">\n<p class=\"MsoNormal\" style=\"margin-right:.1pt;text-align:justify;\n\n      text-justify:inter-ideograph;line-height:14.0pt\">No more than 10 units of\n\n      courses taken to fulfill the requirements of the students’</p>\n<p class=\"MsoNormal\" style=\"margin-right:.1pt;text-align:justify;\n\n      text-justify:inter-ideograph;line-height:14.0pt\">Major Programme(s) and\n\n      other Minor Programme(s) respectively can be used to</p>\n<p class=\"MsoNormal\" style=\"margin-right:.1pt;text-align:justify;\n\n      text-justify:inter-ideograph;line-height:14.0pt\">fulfill the requirement\n\n      of this Minor Programme.</p>\n</td>\n</tr>\n<tr>\n<td style=\"width:35.1pt;padding:0cm 5.4pt 0cm 5.4pt\" valign=\"top\" width=\"47\">\n<p class=\"MsoNormal\" style=\"margin-right:.1pt;text-align:justify;\n\n      text-justify:inter-ideograph;line-height:14.0pt\"><span lang=\"EN-US\"> </span></p>\n</td>\n<td colspan=\"2\" style=\"width:402.0pt;padding:0cm 5.4pt 0cm 5.4pt\" valign=\"top\" width=\"536\">\n<p class=\"MsoNormal\" style=\"margin-right:.1pt;text-align:justify;\n\n      text-justify:inter-ideograph;line-height:14.0pt\"><span lang=\"EN-US\"> </span></p>\n</td>\n</tr></table>"

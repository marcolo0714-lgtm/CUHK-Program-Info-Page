  "explanatory_notes": "<table><tr> <td colspan=\"3\" style=\"width:463.2pt;padding:0cm 5.4pt 0cm 5.4pt\" valign=\"top\" width=\"618\"> <p class=\"MsoNormal\" style=\"text-align:justify;text-justify:inter-ideograph; line-height:14.0pt\">Explanatory Notes:</p> </td> </tr>\n<tr> <td style=\"width:42.5pt;padding:0cm 5.4pt 0cm 5.4pt\" valign=\"top\" width=\"57\"> <p class=\"MsoNormal\" style=\"line-height:14.0pt\">1.</p> </td> <td colspan=\"2\" style=\"width:420.7pt;padding:0cm 5.4pt 0cm 5.4pt\" valign=\"top\" width=\"561\"> <p class=\"MsoNormal\" style=\"text-align:justify;text-justify:inter-ideograph; line-height:14.0pt\">No more than 9 units of courses taken to fulfill the\n\n requirements of the students’ Major Programme(s) and other Minor\n\n Programme(s) respectively can be used to fulfill the requirement of this\n\n Minor Programme.</p> </td> </tr>\n<tr> <td style=\"width:42.5pt;padding:0cm 5.4pt 0cm 5.4pt\" valign=\"top\" width=\"57\"> <p class=\"MsoNormal\" style=\"line-height:14.0pt\">2. </p> </td> <td colspan=\"2\" style=\"width:420.7pt;padding:0cm 5.4pt 0cm 5.4pt\" valign=\"top\" width=\"561\"> <p class=\"MsoNormal\" style=\"text-align:justify;text-justify:inter-ideograph; line-height:14.0pt\">Units taken to fulfill the requirement of the\n\n Journalism and Communication Programme (including Major Programmes,\n\n Double Major Programmes, Double Degree Options and Minor Programme) and\n\n Global Studies Programme (including Major Programme and Minor Programme) cannot\n\n be used to fulfill the requirement of this Minor Programme.</p> </td> </tr>\n<tr> <td style=\"width:42.5pt;padding:0cm 5.4pt 0cm 5.4pt\" valign=\"top\" width=\"57\"> <p class=\"MsoNormal\" style=\"line-height:14.0pt\"> </p> </td> <td colspan=\"2\" style=\"width:420.7pt;padding:0cm 5.4pt 0cm 5.4pt\" valign=\"top\" width=\"561\"> <p class=\"MsoNormal\" style=\"text-align:justify;text-justify:inter-ideograph; line-height:14.0pt\"> </p> </td> </tr></table>"

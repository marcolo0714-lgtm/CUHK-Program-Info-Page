  "explanatory_notes": "<table><tr style=\"height:5.2pt\">\n<td colspan=\"3\" style=\"width:474.9pt;padding:0cm 5.4pt 0cm 5.4pt;\n\n      height:5.2pt\" valign=\"top\" width=\"633\">\n<p class=\"MsoNormal\" style=\"line-height:14.0pt\"><span lang=\"EN-US\">Explanatory\n\n      Notes:</span></p>\n</td>\n</tr>\n<tr style=\"height:5.2pt\">\n<td style=\"width:35.45pt;padding:0cm 5.4pt 0cm 5.4pt;\n\n      height:5.2pt\" valign=\"top\" width=\"47\">\n<p class=\"MsoNormal\" style=\"line-height:14.0pt\"><span lang=\"EN-US\">1.</span></p>\n</td>\n<td colspan=\"2\" style=\"width:439.45pt;padding:0cm 5.4pt 0cm 5.4pt;\n\n      height:5.2pt\" valign=\"top\" width=\"586\">\n<p class=\"MsoNormal\" style=\"margin-right:2.75pt;text-align:justify;\n\n      text-justify:inter-ideograph;line-height:14.0pt\"><span lang=\"EN-US\">This\n\n      Minor Programme is not applicable to students who major in Risk\n\n      Management Science, Global Economics and Finance, Quantitative Finance\n\n      and Risk Management Science, Bachelor of Business Administration\n\n      (Integrated BBA Programme) and Juris Doctor Programme, and programmes under\n\n      the Faculty of Business Administration.</span></p>\n</td>\n</tr>\n<tr style=\"height:5.2pt\">\n<td style=\"width:35.45pt;padding:0cm 5.4pt 0cm 5.4pt;\n\n      height:5.2pt\" valign=\"top\" width=\"47\">\n<p class=\"MsoNormal\" style=\"line-height:14.0pt\"><span lang=\"EN-US\">2.</span></p>\n</td>\n<td colspan=\"2\" style=\"width:439.45pt;padding:0cm 5.4pt 0cm 5.4pt;\n\n      height:5.2pt\" valign=\"top\" width=\"586\">\n<p class=\"MsoNormal\" style=\"margin-right:2.75pt;text-align:justify;\n\n      text-justify:inter-ideograph;line-height:14.0pt\"><span lang=\"EN-US\">This\n\n      Minor Programme is also not applicable to students who pursue the\n\n      following programmes: Bachelor of Business Administration in Integrated\n\n      BBA Programme and Financial Technology Double Major Programme; Bachelor\n\n      of Engineering in Financial 
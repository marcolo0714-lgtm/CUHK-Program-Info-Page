  "explanatory_notes": "<table><tr> <td colspan=\"4\" style=\"width:497.75pt;border-top:none; border-left:solid windowtext 1.0pt;border-bottom:none;border-right:solid windowtext 1.0pt; padding:0cm 5.4pt 0cm 5.4pt\" valign=\"top\" width=\"664\"> <p class=\"MsoNormal\" style=\"text-align:justify;text-justify:inter-ideograph; line-height:14.0pt\"><span lang=\"EN-US\">Explanatory Note:</span></p> </td> </tr>\n<tr> <td style=\"width:48.85pt;border:none;border-left:solid windowtext 1.0pt; padding:0cm 5.4pt 0cm 5.4pt\" valign=\"top\" width=\"65\"> <p class=\"MsoNormal\" style=\"line-height:14.0pt\"><span lang=\"EN-US\">1.</span></p> </td> <td colspan=\"3\" style=\"width:448.9pt;border:none; border-right:solid windowtext 1.0pt;padding:0cm 5.4pt 0cm 5.4pt\" valign=\"top\" width=\"599\"> <p class=\"MsoNormal\" style=\"text-align:justify;text-justify:inter-ideograph; line-height:14.0pt\"><span lang=\"EN-US\">Students planning to Minor in Music\n\n must have attained at least Grade 5 in theory and instrument/voice in the\n\n examination of the Associated Board of the Royal Schools of Music, or\n\n equivalent, and may be asked to attend an interview.</span></p> </td> </tr>\n<tr> <td style=\"width:48.85pt;border:none;border-left:solid windowtext 1.0pt; padding:0cm 5.4pt 0cm 5.4pt\" valign=\"top\" width=\"65\"> <p class=\"MsoNormal\" style=\"line-height:14.0pt\"><span lang=\"EN-US\">2.</span></p> </td> <td colspan=\"3\" style=\"width:448.9pt;border:none; border-right:solid windowtext 1.0pt;padding:0cm 5.4pt 0cm 5.4pt\" valign=\"top\" width=\"599\"> <p class=\"MsoNormal\" style=\"text-align:justify;text-justify:inter-ideograph; line-height:14.0pt\"><span lang=\"EN-US\">This Minor Programme is not applicable\n\n to students who major in Music.</span></p> </td> </tr>\n<tr> <td style=\"width:48.85pt;border-top:none;border-left:\n\n solid windowtext 1.0pt;border-bottom:solid windowtext 1.0pt;border-right:\n\n none;padding:0cm 5.4pt 0cm 5.4pt\" valign=\"top\" width=\"65\"> <p class=\"MsoNormal\" style=\"line-height:14.0pt\"><span lang=\"EN-US\">3.</span></p> </td> <td colspan=\"3\" style=\"width:448.9pt;border-top:none; border-left:none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt; padding:0cm 5.4pt 0cm 5.4pt\" valign=\"top\" width=\"599\"> <p class=\"MsoNormal\" style=\"text-align:justify;text-justify:inter-ideograph; line-height:14.0pt\"><span lang=\"EN-US\">No more than 9 units of courses taken\n\n to fulfill the requirements of the students’ Major P</span>rogramme(s) and\n\n other Minor Programme(s) respectively can be used to fulfil the requirement\n\n of this Minor Programme.</p> </td> </tr></table>"

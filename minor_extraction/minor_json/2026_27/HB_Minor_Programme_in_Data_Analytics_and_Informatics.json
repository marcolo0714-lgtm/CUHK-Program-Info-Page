  "explanatory_notes": "<table><tr style=\"height:5.2pt\">\n<td colspan=\"4\" style=\"width:439.45pt;padding:0cm 5.4pt 0cm 5.4pt;\n\n      height:5.2pt\" valign=\"top\" width=\"586\">\n<p class=\"MsoNormal\" style=\"line-height:14.0pt\"><span lang=\"EN-US\">Explanatory\n\n      Notes:</span></p>\n</td>\n</tr>\n<tr style=\"height:5.2pt\">\n<td style=\"width:35.45pt;padding:0cm 5.4pt 0cm 5.4pt;\n\n      height:5.2pt\" valign=\"top\" width=\"47\">\n<p class=\"MsoNormal\" style=\"line-height:14.0pt\"><span lang=\"EN-US\">1.</span></p>\n</td>\n<td colspan=\"3\" style=\"width:404.0pt;padding:0cm 5.4pt 0cm 5.4pt;\n\n      height:5.2pt\" valign=\"top\" width=\"539\">\n<p class=\"MsoNormal\" style=\"text-align:justify;text-justify:inter-ideograph;\n\n      line-height:14.0pt\"><span lang=\"EN-US\">This Minor Programme is not\n\n      applicable to students who major in Artificial Intelligence: Systems and\n\n      Technologies, Computer Science, Information Engineering, Mathematics and\n\n      Information Engineering, and Systems Engineering and Engineering\n\n      Management.</span></p>\n</td>\n</tr>\n<tr style=\"height:5.2pt\">\n<td style=\"width:35.45pt;padding:0cm 5.4pt 0cm 5.4pt;\n\n      height:5.2pt\" valign=\"top\" width=\"47\">\n<p class=\"MsoNormal\" style=\"line-height:14.0pt\"><span lang=\"EN-US\">2.</span></p>\n</td>\n<td colspan=\"3\" style=\"width:404.0pt;padding:0cm 5.4pt 0cm 5.4pt;\n\n      height:5.2pt\" valign=\"top\" width=\"539\">\n<p class=\"MsoNormal\" style=\"text-align:justify;text-justify:inter-ideograph;\n\n      line-height:14.0pt\"><span lang=\"EN-US\">No more than 9 units of courses\n\n      taken to fulfill the requirements of the students’ Major Programme(s) and\n\n      other Minor Programme(s) respectively can be used to fulfill the\n\n      requirement of this Minor Programme.</span></p>\n</td>\n</tr>\n<tr style=\"height:5.2pt\">\n<td style=\"width:35.45pt;padding:0cm 5.4pt 0cm 5.4pt;\n\n      height:5.2pt\" valign=\"top\" width=\"47\">\n<p class=\"MsoNormal\" style=\"line-height:14.0pt\"><span lang=\"EN-US\">[a]</span></p>\n</td>\n<td colspan=\"3\" style=\"width:404.0pt;padding:0cm 5.4pt 0cm 5.4pt;\n\n      height:5.2pt\" valign=\"top\" width=\"539\">\n<p class=\"MsoNormal\" style=\"text-align:justify;text-justify:inter-ideograph;\n\n      line-height:14.0pt\"><span lang=\"EN-US\">Non-engineering students who wish to\n\n      use other courses to substitute the required courses will have to seek\n\n      approval from the Programme Director.</span></p>\n</td>\n</tr>\n<tr style=\"height:5.2pt\">\n<td style=\"width:35.45pt;padding:0cm 5.4pt 0cm 5.4pt;\n\n      height:5.2pt\" valign=\"top\" width=\"47\">\n<p class=\"MsoNormal\" style=\"line-height:14.0pt\"><span lang=\"EN-US\">[b]</span></p>\n</td>\n<td colspan=\"3\" style=\"width:404.0pt;padding:0cm 5.4pt 0cm 5.4pt;\n\n      height:5.2pt\" valign=\"top\" width=\"539\">\n<p class=\"MsoNormal\" style=\"text-align:justify;text-justify:inter-ideograph;\n\n      line-height:14.0pt\"><span lang=\"EN-US\">ESTR courses are developed based on\n\n      ordinary engineering courses with additional course materials and\n\n      challenging assessments.  The courses are only applicable to\n\n      students of the ELITE stream, who can choose a combination of the ESTR\n\n      courses or the equivalent courses listed in the curriculum to fulfill the\n\n      minor programme requirements.</span></p>\n</td>\n</tr>\n<tr style=\"height:5.2pt\">\n<td style=\"width:35.45pt;padding:0cm 5.4pt 0cm 5.4pt;\n\n      height:5.2pt\" valign=\"top\" width=\"47\">\n<p class=\"MsoNormal\" style=\"line-height:14.0pt\"><span lang=\"EN-US\"> </span></p>\n</td>\n<td colspan=\"3\" style=\"width:404.0pt;padding:0cm 5.4pt 0cm 5.4pt;\n\n      height:5.2pt\" valign=\"top\" width=\"539\">\n<p class=\"MsoNormal\" style=\"text-align:justify;text-justify:inter-ideograph;\n\n      line-height:14.0pt\"><span lang=\"EN-US\"> </span></p>\n</td>\n</tr></table>",

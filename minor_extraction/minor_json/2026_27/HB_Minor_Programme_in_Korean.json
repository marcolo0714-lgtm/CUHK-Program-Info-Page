  "explanatory_notes": "<table><tr>\n<td colspan=\"3\" style=\"width:440.0pt;padding:0cm 5.4pt 0cm 5.4pt\" valign=\"top\" width=\"587\">\n<p class=\"MsoNormal\" style=\"text-align:justify;text-justify:inter-ideograph;\n\n      layout-grid-mode:char\"><span lang=\"EN-US\">Explanatory Notes:</span></p>\n</td>\n</tr>\n<tr>\n<td style=\"width:33.75pt;padding:0cm 5.4pt 0cm 5.4pt\" valign=\"top\" width=\"45\">\n<p class=\"MsoNormal\" style=\"layout-grid-mode:char\"><span lang=\"EN-US\">1.</span></p>\n</td>\n<td colspan=\"2\" style=\"width:406.25pt;padding:0cm 5.4pt 0cm 5.4pt\" valign=\"top\" width=\"542\">\n<p class=\"MsoNormal\" style=\"text-align:justify;text-justify:inter-ideograph;\n\n      layout-grid-mode:char\">No more than 9 units of courses taken to fulfill\n\n      the requirements of the students’ Major Programme(s) and other Minor Programme(s)\n\n      respectively can be used to fulfill the requirement of this Minor Programme.</p>\n</td>\n</tr>\n<tr>\n<td style=\"width:33.75pt;padding:0cm 5.4pt 0cm 5.4pt\" valign=\"top\" width=\"45\">\n<p class=\"MsoNormal\" style=\"layout-grid-mode:char\"><span lang=\"EN-US\">[a]</span></p>\n</td>\n<td colspan=\"2\" style=\"width:406.25pt;padding:0cm 5.4pt 0cm 5.4pt\" valign=\"top\" width=\"542\">\n<p class=\"MsoNormal\" style=\"text-align:justify;text-justify:inter-ideograph;\n\n      layout-grid-mode:char\"><span lang=\"EN-US\">Students who have prior knowledge\n\n      of Korean before admission may be exempted from taking KORE2000, 2001,\n\n      2050, 3000, 3001 and 3050. They should seek the advice of the Department\n\n      to take substitute courses in accordance with their academic\n\n      qualifications.</span></p>\n</td>\n</tr>\n<tr>\n<td style=\"width:33.75pt;padding:0cm 5.4pt 0cm 5.4pt\" valign=\"top\" width=\"45\">\n<p class=\"MsoNormal\" style=\"layout-grid-mode:char\"><span lang=\"EN-US\">[b]</span></p>\n</td>\n<td colspan=\"2\" style=\"width:406.25pt;padding:0cm 5.4pt 0cm 5.4pt\" valign=\"top\" width=\"542\">\n<p class=\"MsoNormal\" style=\"text-align:justify;text-justify:inter-ideograph;\n\n      layout-grid-mode:char\"><span lang=\"EN-US\">Students who have taken the\n\n      summer intensive course KORE2050 will be recognized as having fulfilled\n\n      this requirement.</span></p>\n</td>\n</tr>\n<tr>\n<td style=\"width:33.75pt;padding:0cm 5.4pt 0cm 5.4pt\" valign=\"top\" width=\"45\">\n<p class=\"MsoNormal\" style=\"layout-grid-mode:char\"><span lang=\"EN-US\">[c]</span></p>\n</td>\n<td colspan=\"2\" style=\"width:406.25pt;padding:0cm 5.4pt 0cm 5.4pt\" valign=\"top\" width=\"542\">\n<p class=\"MsoNormal\" style=\"text-align:justify;text-justify:inter-ideograph;\n\n      layout-grid-mode:char\"><span lang=\"EN-US\">Students who have taken the\n\n      summer intensive course KORE3051 will be recognized as having fulfilled\n\n      this requirement and 3 units of elective courses of Requirement (2).</span></p>\n</td>\n</tr></table>",
